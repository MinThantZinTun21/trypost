APP_NAME="TryPost"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Local dev login — prefilled on the login form only when APP_ENV=local.
# DEV_LOGIN_EMAIL=admin@trypost.it
# DEV_LOGIN_PASSWORD=password

# The single Owner created by `php artisan db:seed` (runs once; skipped when a
# user already exists). Leave OWNER_PASSWORD empty to have the seeder generate
# one and print it once. Change it later with `php artisan owner:reset-password`.
OWNER_NAME="Owner"
OWNER_EMAIL=admin@trypost.it
OWNER_PASSWORD=

META_PAGE_WALK_SECONDS=20

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL or MySQL)
# PostgreSQL: DB_CONNECTION=pgsql, DB_PORT=5432, DB_USERNAME=postgres
# MySQL: DB_CONNECTION=mysql, DB_PORT=3306, DB_USERNAME=root
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trypost
DB_USERNAME=postgres
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue, Cache — both run on Postgres.
QUEUE_CONNECTION=database
CACHE_STORE=database

# File Storage
# Options: local, s3, r2 (or any S3-compatible: MinIO, DigitalOcean Spaces, etc.)
FILESYSTEM_DISK=local

# The app sends no email. Mail stays on the log driver.
MAIL_MAILER=log

# AWS S3 (set FILESYSTEM_DISK=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# Cloudflare R2 (set FILESYSTEM_DISK=r2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_URL=

# DigitalOcean Spaces (set FILESYSTEM_DISK=spaces)
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=

# ============================================
# Social Platform Credentials
# ============================================
# Get your API keys from each platform's developer portal

# TikTok (https://developers.tiktok.com)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_CLIENT_REDIRECT="${APP_URL}/accounts/tiktok/callback"
# Trim when the TikTok app lacks Display API (no longer offered to new apps):
# TIKTOK_SCOPES="user.info.basic,video.publish,video.upload"

# Facebook (https://developers.facebook.com)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CLIENT_REDIRECT="${APP_URL}/accounts/facebook/callback"

# Google (https://console.cloud.google.com)
# Used for YouTube social account connection
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_REDIRECT="${APP_URL}/accounts/youtube/callback"

# Platform feature flags (all default to true; set to false to hide a platform)
# FACEBOOK_ENABLED=true
# TIKTOK_ENABLED=true
# YOUTUBE_ENABLED=true

# Vite
VITE_APP_NAME="${APP_NAME}"
