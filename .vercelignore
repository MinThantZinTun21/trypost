.env.*
!.env.example
compose.prod.local.yaml
/vendor
/node_modules
/storage/*
/tests
/docker
/docs
/maizzle
/.git
/.github
/.claude
/.cursor
/.agents
/public/storage
/public/hot
/bootstrap/cache/*.php
/.vercel-static
